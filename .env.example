# --- Server ---
NODE_ENV=development
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info

# --- Auth (v1: shared key between Doctor Portal and this service, min 32 chars) ---
API_KEY=replace-with-a-long-random-secret-key-32chars
# Comma-separated list of allowed browser origins
CORS_ORIGIN=http://localhost:4200

# --- HIS ClinicalsAPI ---
HIS_BASE_URL=https://his.alhammadi.med.sa/ClinicalsAPI/API
HIS_USERNAME=
HIS_PASSWORD=
HIS_TIMEOUT_MS=6000

# --- LLM ---
LLM_PROVIDER=google
MODEL=gemini-3.5-flash-lite
GOOGLE_GENERATIVE_AI_API_KEY=

# --- Audit (secret used to hash patient identifiers in logs, min 16 chars) ---
AUDIT_HASH_SECRET=replace-with-another-random-secret
