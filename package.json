{
  "name": "ahh-ai-agents",
  "version": "0.1.0",
  "private": true,
  "description": "AHH AI agents microservice - hosts clinical AI agents for the Doctor Portal",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ai-sdk/google": "^3.0.130",
    "@fastify/cors": "^11.3.0",
    "ai": "^6.0.301",
    "dotenv": "^18.0.5",
    "fastify": "^5.12.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@ai-sdk/provider": "^3.0.18",
    "@types/node": "^20.19.43",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
